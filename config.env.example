# Generated automatically on first install. Do not put the actual web.env in Git.
# Optional first-install secret, provided through the install process environment.
# Empty means generate a random password. Existing administrator passwords are preserved.
ADMIN_PASSWORD=
PANEL_BIND=127.0.0.1
PANEL_PORT=8080
PANEL_HOSTS=localhost,127.0.0.1,::1,YOUR_SERVER_IP
PUBLIC_IP=YOUR_SERVER_IP
COOKIE_SECURE=0
DATABASE_PATH=/var/lib/mihomo-panel/panel.sqlite3
# Optional first-install key; empty means generate it once during installation.
# Back up the generated web.env together with the database.
FERNET_KEY=
MIHOMO_BIN=/opt/mihomo-panel/core/mihomo
FIREWALL_MODE=auto
PANEL_FIREWALL=0
